# Konfigurasi Cloud Database Real-time (Supabase)
# Salin file ini menjadi .env.local dan isi dengan konfigurasi project Supabase Anda
# Catatan: Jika belum diisi, aplikasi tetap berjalan 100% dengan mode Local Real-Time Storage!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
